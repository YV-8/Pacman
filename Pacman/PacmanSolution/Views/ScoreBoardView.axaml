<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="PacmanSolution.Views.ScoreBoardPageView">
    <UserControl.Styles>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="30"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#FFD700"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="TextAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="#AAAAAA"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="TextBlock.value">
      <Setter Property="Foreground" Value="#FFD700"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="Button.gold">
      <Setter Property="Background" Value="#FFD700"/>
      <Setter Property="Foreground" Value="#0D0D1A"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="Padding" Value="18,8"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.red">
      <Setter Property="Background" Value="#CC2200"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="Padding" Value="18,8"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#888888"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Margin="0">

    <!-- Header -->
    <StackPanel Grid.Row="0" Spacing="2" Margin="0,30,0,16">
      <TextBlock Classes="title" Text="🕹  SCOREBOARD"/>
    </StackPanel>

    <!-- Contenido central -->
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="16" MaxWidth="360" HorizontalAlignment="Center" Margin="20,0">

        <!-- Scores actuales del juego -->
        <Border Background="#1A1A2E" CornerRadius="10" Padding="18,14">
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="10">
            <TextBlock Classes="label" Grid.Row="0" Grid.Column="0" Text="SCORE"/>
            <TextBlock Classes="value" Grid.Row="0" Grid.Column="1" Text="{Binding Score}"/>
            <TextBlock Classes="label" Grid.Row="1" Grid.Column="0" Text="HIGH SCORE"/>
            <TextBlock Classes="value" Grid.Row="1" Grid.Column="1" Text="{Binding HighScore}"/>
          </Grid>
        </Border>

        <!-- Top 5 -->
        <TextBlock Foreground="#888888"
                   FontSize="11"
                   FontWeight="Bold"
                   Text="— TOP 5 —"
                   HorizontalAlignment="Center"
                   LetterSpacing="3"/>

        <Border Background="#1A1A2E" CornerRadius="10" Padding="18,14">
          <ItemsControl ItemsSource="{Binding HighScores}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="28,*,Auto" Margin="0,5">
                  <!-- Posición -->
                  <TextBlock Foreground="#555577" FontSize="12"
                             Text="{Binding $index}" Grid.Column="0"
                             VerticalAlignment="Center"/>
                  <!-- Nombre -->
                  <TextBlock Foreground="White" FontWeight="Bold" FontSize="15"
                             Text="{Binding Name}" Grid.Column="1"
                             VerticalAlignment="Center"/>
                  <!-- Puntos -->
                  <TextBlock Foreground="#FFD700" FontWeight="Bold" FontSize="15"
                             Text="{Binding Points}" Grid.Column="2"
                             VerticalAlignment="Center"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <!-- Botón Save (oculto si el panel ya está abierto) -->
        <Button Classes="gold"
                Content="💾  Save My Score"
                Command="{Binding ShowSavePanelCommand}"
                HorizontalAlignment="Center"
                IsVisible="{Binding !IsSavePanelVisible}"/>

        <!-- Panel de guardado -->
        <Border Background="#1A1A2E" CornerRadius="10" Padding="20,16"
                IsVisible="{Binding IsSavePanelVisible}">
          <StackPanel Spacing="14">

            <TextBlock Text="Enter your 3-letter initials"
                       Foreground="White" FontSize="14" FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <TextBox Text="{Binding PlayerName}"
                     MaxLength="3"
                     FontSize="28"
                     FontWeight="Bold"
                     TextAlignment="Center"
                     Foreground="#FFD700"
                     Background="#0D0D1A"
                     BorderBrush="#FFD700"
                     BorderThickness="2"
                     CornerRadius="6"
                     HorizontalAlignment="Center"
                     Width="90"
                     Height="56"
                     Watermark="AAA"/>

            <!-- Mensaje de error -->
            <TextBlock Text="{Binding SaveMessage}"
                       Foreground="#FF5555"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       IsVisible="{Binding SaveMessage,
                           Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
              <Button Classes="gold" Content="✔  Save" Command="{Binding SaveDataCommand}"/>
              <Button Classes="red"  Content="✖  Cancel" Command="{Binding CancelSaveCommand}"/>
            </StackPanel>

          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <!-- Footer: botón volver -->
    <Button Grid.Row="2"
            Classes="ghost"
            Content="← Back to Menu"
            Command="{Binding NavigateCommand}"
            HorizontalAlignment="Center"
            Margin="0,10,0,24"/>

  </Grid>
</UserControl>
